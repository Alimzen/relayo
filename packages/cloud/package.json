{
  "name": "@alimzen/relayo-cloud",
  "version": "0.0.0",
  "description": "Relayo Cloud driver: send email and SMS through the Relayo platform with one API key (rly_test_ to simulate, rly_live_ to deliver through your providers), and get every event through one signed webhook.",
  "license": "MIT",
  "author": "Alimzen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alimzen/relayo.git",
    "directory": "packages/cloud"
  },
  "homepage": "https://github.com/Alimzen/relayo/tree/main/packages/cloud#readme",
  "bugs": {
    "url": "https://github.com/Alimzen/relayo/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@alimzen/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "relayo",
    "email",
    "sms",
    "gateway",
    "webhooks",
    "bounces",
    "failover"
  ],
  "peerDependencies": {
    "@alimzen/relayo": ">=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@alimzen/relayo": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@alimzen/relayo-simulator": "workspace:^"
  },
  "files": [
    "dist"
  ]
}
