{
  "name": "@relayo/smtp",
  "version": "0.0.0",
  "description": "SMTP driver for Relayo, built on Nodemailer.",
  "license": "MIT",
  "author": "Alimzen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alimzen/relayo.git",
    "directory": "packages/smtp"
  },
  "homepage": "https://github.com/Alimzen/relayo/tree/main/packages/smtp#readme",
  "bugs": {
    "url": "https://github.com/Alimzen/relayo/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@relayo/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "relayo",
    "smtp",
    "email",
    "nodemailer"
  ],
  "dependencies": {
    "nodemailer": "^10.1.2"
  },
  "peerDependencies": {
    "@relayo/core": ">=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@relayo/core": "workspace:^",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.19.23"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  }
}
